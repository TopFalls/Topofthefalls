node_modules
dist
.env.local
.env.*.local
.env.local.backup-*
*.log
.DS_Store

.vercel

# Supabase CLI local link/cache; never commit project temp state
supabase/.temp/

# Local diagnostic logs
npm-install-log.txt
npm-build-log.txt

# ruflo: keep full-harness runtime/worker state and any secrets out of git
# (see docs/ruflo.md). The curated .claude/agents/ files ARE committed.
.claude-flow/
.mcp.json
*.bak

# Ignore generated agent runtime files by default. Repository-authored Codex
# skills may be committed through narrow exceptions; never unignore all of
# .agents/. Add another explicit skill path only when that skill is intentionally
# maintained as project source.
.agents/
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/tof-bootstrap/
!.agents/skills/tof-bootstrap/SKILL.md
!.agents/skills/tof-release/
!.agents/skills/tof-release/SKILL.md
!.agents/skills/tof-rule-change/
!.agents/skills/tof-rule-change/SKILL.md
!.agents/skills/tof-production-qa/
!.agents/skills/tof-production-qa/SKILL.md
!.agents/skills/tof-incident-diagnostics/
!.agents/skills/tof-incident-diagnostics/SKILL.md
